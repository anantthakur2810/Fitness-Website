# ============================================================================
# Anytime Fitness Sohna — Vercel Environment Variables (.env.example)
# Import this file directly in Vercel:
#   Project Settings -> Environment Variables -> Import .env
#
# NOTE on MongoDB Atlas (Vercel Storage Integration):
#   When you connect MongoDB Atlas from Vercel's Storage tab, Vercel
#   automatically injects MONGODB_URI into your project's server environment.
#   NEVER prefix MONGODB_URI with VITE_ (keep it server-side only!).
# ============================================================================

# --- Server-Side MongoDB (Used by /api/gym.js Vercel Serverless Function) ---
# Auto-set by Vercel Storage -> MongoDB Atlas (only needed manually for local `vercel dev`)
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="gym_db"

# --- Club Branding & Location (Client-Side VITE_* Variables) ---
VITE_GYM_NAME="Anytime Fitness"
VITE_GYM_BRANCH="Sohna"
VITE_GYM_FULL_NAME="Anytime Fitness — Sector 34, Sohna"
VITE_GYM_ADDRESS="4th & 5th Floor, The Leaf Mall, Sector 34, Sohna, Gurugram, Haryana 122103"
VITE_GYM_PHONE="+91 87965 67500"
VITE_GYM_WHATSAPP="918796567500"

# --- Maps & Official Social Handles ---
VITE_GYM_MAPS_URL="https://maps.app.goo.gl/yWkfrEVoVgs1v3Ao6"
VITE_GYM_INSTAGRAM_URL="https://www.instagram.com/anytimefitnesssec34sohna/"
VITE_GYM_FACEBOOK_URL="https://www.facebook.com/ATFitnessIN"
VITE_GYM_YOUTUBE_URL="https://www.youtube.com/@AnytimeFitnessIndiaATFITNESSIN"
VITE_GYM_X_URL="https://x.com/ATFitnessIN"
VITE_GYM_LINKEDIN_URL="https://www.linkedin.com/company/anytime-fitness-india/"
VITE_GYM_WEBSITE_URL="https://www.anytimefitness.co.in/gyms/sohna-haryana/"

# --- App Defaults & Penalty Policy ---
VITE_DEFAULT_THEME="theme-dark"
VITE_CURRENCY_CODE="INR"
VITE_DEFAULT_GRACE_DAYS="5"
VITE_DEFAULT_PENALTY_PER_DAY="10"
VITE_DEFAULT_MAX_PENALTY="500"
VITE_STORAGE_KEY="GYM_DB_STORAGE_V4"

